* text=auto eol=lf

# Shell 脚本必须 LF，否则 Linux 容器执行会报 "command not found"
*.sh    text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Windows 批处理保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
